# Shell scripts are executed by CI runners (Linux) and Git Bash on Windows.
# CRLF in a shebang line breaks them, so normalise the whole tree to LF in the
# repository and on checkout, regardless of the cloner's core.autocrlf.
* text=auto eol=lf

*.png  binary
*.jpg  binary
*.gif  binary
*.zip  binary
*.pdf  binary
