# ---- Terraform ----------------------------------------------------------
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json
crash.log
crash.*.log
# Generated by scripts/bootstrap.sh. Embeds the AWS account id, so it is regenerated
# per clone rather than committed. .terraform.lock.hcl IS committed — provider pinning is
# reproducibility, not a secret.
infra/backend.hcl
# Anything ending in .auto.tfvars may carry account-specific values -> never commit.
*.auto.tfvars
*.auto.tfvars.json
.terraformrc
terraform.rc

# ---- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ---- Local artefacts ----------------------------------------------------
.env
.env.*
# Real corpora are downloaded, not committed. The small sample fixture is the exception.
data/raw/*
!data/raw/sample_movie_plots.csv
data/index/
artifacts/
*.log

# ---- Editors / OS -------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Case brief, kept locally rather than committed.
DevOps_Infra_Level_Instructions.pdf

# Presentation material about the solution
presentation/
